# --- Caspian ---
CASPIAN_API_KEY=comm_sandbox_xxx
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=ghostwriter
# Paste the token @BotFather gave you (Telegram -> message @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# --- AI ---
# "groq" is free, no credit card needed -> console.groq.com/keys
# "anthropic" is paid, needs credit in Plans & Billing -> console.anthropic.com
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=sk-ant-xxx
AI_MODEL=claude-sonnet-4-5

# --- Behavior tuning ---
# how long (seconds) an inbound email can sit unanswered before the agent acts
UNANSWERED_THRESHOLD_SECONDS=14400
# background watcher poll interval, seconds
WATCH_INTERVAL_SECONDS=30
# how many approved-as-is replies to a sender before auto-send kicks in
TRUST_AUTO_SEND_THRESHOLD=5
